{
  "name": "swe-forge-pi-subagents",
  "version": "0.1.0",
  "description": "Minimal Pi package skeleton for SWE Forge SUBAGENTS",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "package.json",
    "tsconfig.json"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "swe-forge",
    "child-agent"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "24.12.4",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
